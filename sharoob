#!/data/data/com.termux/files/usr/bin/bash
# Sharoob VPN Launcher with safe auto-update

GH_USER="sawsan180"
GH_REPO="sharoob-vpn"
GH_BRANCH="main"
BASE="https://raw.githubusercontent.com/${GH_USER}/${GH_REPO}/${GH_BRANCH}"

INSTALL_DIR="/data/data/com.termux/files/usr/bin"
BIN="${INSTALL_DIR}/sharoob.bin"
BIN_BAK="${INSTALL_DIR}/sharoob.bin.bak"
VER_FILE="${INSTALL_DIR}/.sharoob_version"

G='\033[1;32m'; Y='\033[1;33m'; R='\033[0m'

LOCAL_VER="0"
[ -f "$VER_FILE" ] && LOCAL_VER=$(cat "$VER_FILE" 2>/dev/null | head -1)

# First run: download binary
if [ ! -f "$BIN" ]; then
    echo -e "${Y}[*] First run - downloading core...${R}"
    if curl -fsSL --max-time 60 -o "${BIN}.new" "${BASE}/sharoob.bin"; then
        SIZE=$(stat -c%s "${BIN}.new" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 10000 ]; then
            chmod +x "${BIN}.new"
            mv "${BIN}.new" "$BIN"
            REMOTE_VER=$(curl -fsS --max-time 3 "${BASE}/version.txt" 2>/dev/null | head -1)
            [ -n "$REMOTE_VER" ] && echo "$REMOTE_VER" > "$VER_FILE"
            echo -e "${G}[+] Core installed.${R}"
            sleep 1
        else
            rm -f "${BIN}.new"
            echo -e "${Y}[!] Download corrupted.${R}"
            exit 1
        fi
    else
        echo -e "${Y}[!] Download failed.${R}"
        exit 1
    fi
fi

# Update check
REMOTE_VER=""
if command -v curl &>/dev/null; then
    REMOTE_VER=$(curl -fsS --max-time 3 "${BASE}/version.txt" 2>/dev/null | head -1)
fi

if [ -n "$REMOTE_VER" ] && [ "$REMOTE_VER" != "$LOCAL_VER" ]; then
    echo -e "${Y}[*] Update: ${REMOTE_VER} (current: ${LOCAL_VER})${R}"
    if curl -fsSL --max-time 60 -o "${BIN}.new" "${BASE}/sharoob.bin"; then
        SIZE=$(stat -c%s "${BIN}.new" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 10000 ]; then
            chmod +x "${BIN}.new"
            [ -f "$BIN" ] && cp "$BIN" "$BIN_BAK"
            mv "${BIN}.new" "$BIN"
            echo "$REMOTE_VER" > "$VER_FILE"
            echo -e "${G}[+] Updated to ${REMOTE_VER}${R}"
            sleep 1
        else
            rm -f "${BIN}.new"
            echo -e "${Y}[!] Update corrupted.${R}"
            sleep 1
        fi
    else
        echo -e "${Y}[!] Update failed.${R}"
        sleep 1
    fi
fi

exec "$BIN" "$@"
