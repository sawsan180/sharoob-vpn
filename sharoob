#!/data/data/com.termux/files/usr/bin/bash
# Sharoob VPN Launcher v2.3.12 - Clean Update (md5-verified)

GH_USER="sawsan180"
GH_REPO="sharoob-vpn"
GH_BRANCH="main"
BASE="https://raw.githubusercontent.com/${GH_USER}/${GH_REPO}/${GH_BRANCH}"
DIR="/data/data/com.termux/files/usr/bin"
VER_FILE="$DIR/.sharoob_version"
BIN_FILE="$DIR/sharoob.bin"
MENU_FILE="$DIR/sharoob_menu.py"
SCAN_FILE="$DIR/sharoob_scan.py"

G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; N='\033[0m'

# ─── Download with retries ───
fetch_new() {
    local url="$1" dest="$2" min="$3" label="$4"
    local i=1
    while [ $i -le 3 ]; do
        rm -f "${dest}"
        curl -fsSL --max-time 30 -o "${dest}" "$url" 2>/dev/null
        local sz=$(stat -c%s "${dest}" 2>/dev/null || echo 0)
        if [ "$sz" -ge "$min" ]; then
            return 0
        fi
        rm -f "${dest}"
        echo -e "${Y}[*] ${label} retry ($i/3)...${N}"
        i=$((i+1))
        sleep 2
    done
    return 1
}

# ─── قراءة الإصدار البعيد ───
REMOTE=$(curl -fsSL --max-time 5 "${BASE}/version.txt" 2>/dev/null | head -1 | tr -d '[:space:]')
[ -z "$REMOTE" ] && { echo -e "${Y}[*] Offline — running local${N}"; }

# ─── الإصدار الفعلي للـ Binary ───
BIN_VER=""
[ -f "$BIN_FILE" ] && BIN_VER=$("$BIN_FILE" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)

# ─── الإصدار المعلن ───
FILE_VER=$(cat "$VER_FILE" 2>/dev/null | tr -d '[:space:]')
[ -z "$FILE_VER" ] && FILE_VER="0"

ALL_OK=1

# ═══════════════════════════════════════════
# 1) Binary: قارن الإصدار الفعلي مع البعيد
# ═══════════════════════════════════════════
if [ -n "$REMOTE" ] && [ "$BIN_VER" != "$REMOTE" ]; then
    echo -e "${Y}[*] Binary: ${BIN_VER:-none} → ${REMOTE}${N}"
    if fetch_new "${BASE}/sharoob.bin" "${BIN_FILE}.candidate" 40000 "Binary"; then
        rm -f "$BIN_FILE"
        mv "${BIN_FILE}.candidate" "$BIN_FILE"
        chmod +x "$BIN_FILE"
        echo -e "${G}[+] Binary updated${N}"
    else
        echo -e "${R}[!] Binary download failed${N}"
        ALL_OK=0
    fi
fi

# ═══════════════════════════════════════════
# 2) Menu: نزّل النسخة الجديدة وقارن md5
#    (هذا هو الإصلاح الجذري)
# ═══════════════════════════════════════════
if [ -n "$REMOTE" ]; then
    if fetch_new "${BASE}/sharoob_menu.py" "${MENU_FILE}.candidate" 5000 "Menu"; then
        # قارن المحتوى
        if [ ! -f "$MENU_FILE" ]; then
            # غير موجود → ضع الجديد
            mv "${MENU_FILE}.candidate" "$MENU_FILE"
            chmod +x "$MENU_FILE"
            echo -e "${G}[+] Menu installed${N}"
        elif ! cmp -s "$MENU_FILE" "${MENU_FILE}.candidate"; then
            # مختلف → احذف القديم ثم ضع الجديد
            rm -f "$MENU_FILE"
            mv "${MENU_FILE}.candidate" "$MENU_FILE"
            chmod +x "$MENU_FILE"
            echo -e "${G}[+] Menu updated (clean)${N}"
        else
            # مطابق → احذف المرشح
            rm -f "${MENU_FILE}.candidate"
        fi
    else
        echo -e "${R}[!] Menu download failed${N}"
        ALL_OK=0
    fi
fi

# ─── حدّث ملف الإصدار بعد نجاح الكل ───
if [ "$ALL_OK" -eq 1 ] && [ -n "$REMOTE" ]; then
    echo "$REMOTE" > "$VER_FILE"
fi

# ─── فحص نهائي ───
MENU_SZ=$(stat -c%s "$MENU_FILE" 2>/dev/null || echo 0)
if [ "$MENU_SZ" -lt 5000 ]; then
    echo -e "${R}[!] Menu missing!${N}"
    echo -e "${Y}[*] Manual:${N}"
    echo "  curl -fsSL ${BASE}/sharoob_menu.py -o $MENU_FILE"
    exit 1
fi


# ─── Scan file: cmp-based update ───
if [ -n "$REMOTE" ]; then
    if fetch_new "${BASE}/sharoob_scan.py" "${SCAN_FILE}.candidate" 1000 "Scan"; then
        if [ ! -f "$SCAN_FILE" ]; then
            mv "${SCAN_FILE}.candidate" "$SCAN_FILE"
            chmod +x "$SCAN_FILE"
            echo -e "${G}[+] Scan installed${N}"
        elif ! cmp -s "$SCAN_FILE" "${SCAN_FILE}.candidate"; then
            rm -f "$SCAN_FILE"
            mv "${SCAN_FILE}.candidate" "$SCAN_FILE"
            chmod +x "$SCAN_FILE"
            echo -e "${G}[+] Scan updated (clean)${N}"
        else
            rm -f "${SCAN_FILE}.candidate"
        fi
    fi
fi

exec python3 "$MENU_FILE" "$@"
