#!/data/data/com.termux/files/usr/bin/bash
# Sharoob VPN Launcher v2.3.9 - Version-verified auto-update

GH_USER="sawsan180"
GH_REPO="sharoob-vpn"
GH_BRANCH="main"
BASE="https://raw.githubusercontent.com/${GH_USER}/${GH_REPO}/${GH_BRANCH}"
DIR="/data/data/com.termux/files/usr/bin"
VER_FILE="$DIR/.sharoob_version"
BIN_FILE="$DIR/sharoob.bin"
MENU_FILE="$DIR/sharoob_menu.py"

G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; N='\033[0m'

# ─── Download with retries + size validation ───
fetch() {
    local url="$1" dest="$2" min="$3" label="$4"
    local i=1
    while [ $i -le 3 ]; do
        rm -f "${dest}.new"
        curl -fsSL --max-time 30 -o "${dest}.new" "$url" 2>/dev/null
        local sz=$(stat -c%s "${dest}.new" 2>/dev/null || echo 0)
        if [ "$sz" -ge "$min" ]; then
            # احذف القديم ثم ضع الجديد
            rm -f "$dest"
            mv "${dest}.new" "$dest"
            chmod +x "$dest" 2>/dev/null
            return 0
        fi
        rm -f "${dest}.new"
        echo -e "${Y}[*] ${label} retry ($i/3)...${N}"
        i=$((i+1))
        sleep 2
    done
    return 1
}

# ─── قراءة الإصدار البعيد ───
REMOTE=$(curl -fsSL --max-time 5 "${BASE}/version.txt" 2>/dev/null | head -1 | tr -d '[:space:]')
if [ -z "$REMOTE" ]; then
    echo -e "${Y}[*] Offline — running local${N}"
fi

# ─── قراءة الإصدار الحقيقي للـ Binary (بالتشغيل) ───
BIN_VER=""
if [ -f "$BIN_FILE" ]; then
    BIN_VER=$("$BIN_FILE" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
fi

# ─── قراءة الإصدار المعلن ───
FILE_VER=$(cat "$VER_FILE" 2>/dev/null | tr -d '[:space:]')
[ -z "$FILE_VER" ] && FILE_VER="0"

# ─── قرار التحديث ───
BIN_NEEDED=0
MENU_NEEDED=0

# 1) فحص Binary: نسخته الفعلية vs النسخة البعيدة
if [ -n "$REMOTE" ] && [ "$BIN_VER" != "$REMOTE" ]; then
    echo -e "${Y}[*] Binary: ${BIN_VER:-none} → ${REMOTE}${N}"
    BIN_NEEDED=1
fi

# 2) فحص menu.py: موجود وكبير كفاية
MENU_SZ=$(stat -c%s "$MENU_FILE" 2>/dev/null || echo 0)
if [ "$MENU_SZ" -lt 5000 ]; then
    MENU_NEEDED=1
fi

# ─── التنزيل ───
ALL_OK=1

if [ "$BIN_NEEDED" -eq 1 ]; then
    if fetch "${BASE}/sharoob.bin" "$BIN_FILE" 40000 "Binary"; then
        echo -e "${G}[+] Binary updated${N}"
    else
        echo -e "${R}[!] Binary download failed${N}"
        ALL_OK=0
    fi
fi

if [ "$MENU_NEEDED" -eq 1 ]; then
    if fetch "${BASE}/sharoob_menu.py" "$MENU_FILE" 5000 "Menu"; then
        echo -e "${G}[+] Menu updated${N}"
    else
        echo -e "${R}[!] Menu download failed${N}"
        ALL_OK=0
    fi
fi

# ─── تحديث ملف الإصدار فقط بعد نجاح الكل ───
if [ "$ALL_OK" -eq 1 ] && [ -n "$REMOTE" ]; then
    echo "$REMOTE" > "$VER_FILE"
fi

# ─── فحص نهائي ───
MENU_SZ=$(stat -c%s "$MENU_FILE" 2>/dev/null || echo 0)
if [ "$MENU_SZ" -lt 5000 ]; then
    echo -e "${R}[!] Menu missing!${N}"
    echo -e "${Y}[*] Manual fix:${N}"
    echo "  curl -fsSL ${BASE}/sharoob_menu.py -o $MENU_FILE"
    exit 1
fi

# ─── تشغيل الواجهة ───
exec python3 "$MENU_FILE" "$@"
