#!/data/data/com.termux/files/usr/bin/bash
# Sharoob VPN Launcher v2.3.6 - Self-healing & Auto-recovery

GH_USER="sawsan180"
GH_REPO="sharoob-vpn"
GH_BRANCH="main"
BASE="https://raw.githubusercontent.com/${GH_USER}/${GH_REPO}/${GH_BRANCH}"
DIR="/data/data/com.termux/files/usr/bin"
VER_FILE="$DIR/.sharoob_version"
BIN_FILE="$DIR/sharoob.bin"
MENU_FILE="$DIR/sharoob_menu.py"

G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; N='\033[0m'

fetch() {
    local url="$1" dest="$2" min="$3" label="$4"
    local i=1
    while [ $i -le 3 ]; do
        curl -fsSL --max-time 30 -o "${dest}.new" "$url" 2>/dev/null
        local sz=$(stat -c%s "${dest}.new" 2>/dev/null || echo 0)
        if [ "$sz" -ge "$min" ]; then
            mv "${dest}.new" "$dest"
            chmod +x "$dest" 2>/dev/null
            return 0
        fi
        rm -f "${dest}.new"
        echo -e "${Y}[*] ${label} retry ($i/3)...${N}"
        i=$((i+1))
        sleep 2
    done
    return 1
}

LOCAL=$(cat "$VER_FILE" 2>/dev/null | tr -d '[:space:]')
REMOTE=$(curl -fsSL --max-time 5 "${BASE}/version.txt" 2>/dev/null | head -1 | tr -d '[:space:]')
[ -z "$LOCAL" ] && LOCAL="0"

MENU_SZ=$(stat -c%s "$MENU_FILE" 2>/dev/null || echo 0)
BIN_SZ=$(stat -c%s "$BIN_FILE" 2>/dev/null || echo 0)

BIN_NEEDED=0
MENU_NEEDED=0
[ "$BIN_SZ" -lt 40000 ] && BIN_NEEDED=1
[ "$MENU_SZ" -lt 5000 ] && MENU_NEEDED=1

if [ -n "$REMOTE" ] && [ "$REMOTE" != "$LOCAL" ]; then
    echo -e "${Y}[*] Update: ${REMOTE} (current: ${LOCAL})${N}"
    BIN_NEEDED=1
fi

ALL_OK=1

if [ "$BIN_NEEDED" -eq 1 ]; then
    if fetch "${BASE}/sharoob.bin" "$BIN_FILE" 40000 "Core"; then
        echo -e "${G}[+] Core updated${N}"
    else
        echo -e "${R}[!] Core download failed${N}"
        ALL_OK=0
    fi
fi

if [ "$MENU_NEEDED" -eq 1 ]; then
    if fetch "${BASE}/sharoob_menu.py" "$MENU_FILE" 5000 "Menu"; then
        echo -e "${G}[+] Menu updated${N}"
    else
        echo -e "${R}[!] Menu download failed${N}"
        ALL_OK=0
    fi
fi

if [ "$ALL_OK" -eq 1 ] && [ -n "$REMOTE" ] && [ "$REMOTE" != "$LOCAL" ]; then
    echo "$REMOTE" > "$VER_FILE"
fi

MENU_SZ=$(stat -c%s "$MENU_FILE" 2>/dev/null || echo 0)
if [ "$MENU_SZ" -lt 5000 ]; then
    echo -e "${R}[!] Menu file is missing or corrupted!${N}"
    echo -e "${Y}[*] Please run this command manually:${N}"
    echo "  curl -fsSL ${BASE}/sharoob_menu.py -o $MENU_FILE"
    exit 1
fi

exec python3 "$MENU_FILE" "$@"
