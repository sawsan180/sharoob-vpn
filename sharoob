#!/data/data/com.termux/files/usr/bin/bash
# Sharoob VPN Launcher v2.3.5

GH_USER="sawsan180"
GH_REPO="sharoob-vpn"
GH_BRANCH="main"
BASE="https://raw.githubusercontent.com/${GH_USER}/${GH_REPO}/${GH_BRANCH}"
DIR="/data/data/com.termux/files/usr/bin"
VER_FILE="$DIR/.sharoob_version"

G='\033[1;32m'; Y='\033[1;33m'; R='\033[0m'

LOCAL=$(cat "$VER_FILE" 2>/dev/null || echo "0")
REMOTE=$(curl -fsS --max-time 3 "$BASE/version.txt" 2>/dev/null | head -1)

# تحديث Binary عند توفّر إصدار جديد
if [ -n "$REMOTE" ] && [ "$REMOTE" != "$LOCAL" ]; then
    echo -e "${Y}[*] Update: ${REMOTE} (current: ${LOCAL})${R}"
    [ -f "$DIR/sharoob.bin" ] && cp "$DIR/sharoob.bin" "$DIR/sharoob.bin.bak"
    if curl -fsSL --max-time 60 -o "$DIR/sharoob.bin.new" "$BASE/sharoob.bin"; then
        SIZE=$(stat -c%s "$DIR/sharoob.bin.new" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt 10000 ]; then
            chmod +x "$DIR/sharoob.bin.new"
            mv "$DIR/sharoob.bin.new" "$DIR/sharoob.bin"
            echo "$REMOTE" > "$VER_FILE"
            echo -e "${G}[+] Updated to ${REMOTE}${R}"
            sleep 1
        else
            rm -f "$DIR/sharoob.bin.new"
        fi
    fi
fi

# تحديث القائمة بصمت (اختياري)
if curl -fsSL --max-time 8 -o "$DIR/sharoob_menu.py.new" "$BASE/sharoob_menu.py" 2>/dev/null; then
    if [ -s "$DIR/sharoob_menu.py.new" ]; then
        mv "$DIR/sharoob_menu.py.new" "$DIR/sharoob_menu.py"
    fi
fi

# تشغيل القائمة
exec python3 "$DIR/sharoob_menu.py" "$@"
